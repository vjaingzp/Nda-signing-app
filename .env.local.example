# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes that must bypass RLS (e.g. the no-login
# counterparty signing flow, which validates a signing-link token itself
# instead of relying on a Postgres policy). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build shareable signing links in emails/UI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

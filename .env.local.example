# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes that must bypass RLS (e.g. the no-login
# counterparty signing flow, which validates a signing-link token itself
# instead of relying on a Postgres policy). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build shareable signing links in emails/UI.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret checked by the /api/cron/cleanup-expired-documents route.
# Vercel Cron sends this automatically as `Authorization: Bearer <value>`
# once the same value is set as a Vercel project env var — see vercel.json.
CRON_SECRET=a-long-random-string

# Credentials for the seeded read/write demo account (see README's "Demo
# account" section). The "Try the demo" button signs in with these via a
# server action — they're never sent to the client.
DEMO_USER_EMAIL=demo@nda-generator.dev
DEMO_USER_PASSWORD=a-password-you-choose
